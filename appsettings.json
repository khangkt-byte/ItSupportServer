{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Database=ItSupportDb; Username=postgres; Password=postgres; Trust Server Certificate=true" //; SSL Mode=VerifyFull; Channel Binding=Require
  },
  "AppSettings": {
    "Issuer": "ItSupportServer",
    "Audience": "ItSupportClient",
    "Token": "your-super-secret-jwt-key-minimum-64-characters-long-for-sha512!!",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 43200,
    "CsrfSecret": "your-csrf-secret-key-min-32-chars-random-string-here"
  },
  "Email": {
    "FromEmail": "khangkttb01029@fpt.edu.vn",
    "AppPassword": "ntps gdqx ccxx ksgy "
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/itsupport-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "ItSupportServer",
      "Environment": "Development"
    }
  },
  "Security": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "https://localhost:5173"
    ]
  }
}
